as="geometry"/></mxCell><mxCell id="c21" value="&lt;font style=&quot;font-size: 30px&quot;&gt;&lt;b&gt;Seeed XIAO ESP32-S3 Sense&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size: 15px&quot; color=&quot;#60646E&quot;&gt;Seeed Studio&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;ul style=&quot;margin: 0 0 0 18px; padding: 0&quot;&gt;&lt;li&gt;ESP32-S3 (Xtensa LX7 dual core, 240 MHz, vector ext.), 8 MB PSRAM, 8 MB flash&lt;/li&gt;&lt;li&gt;Sense board: OV2640 camera, PDM microphone, microSD slot&lt;/li&gt;&lt;li&gt;Flash: esptool over native USB (west flash)&lt;/li&gt;&lt;li&gt;Console: USB serial/JTAG&lt;/li&gt;&lt;li&gt;This repo: TinyDigitNet reading digits from the camera&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=14;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="30" width="650" height="400" as="geometry"/></mxCell><mxCell id="c22" value="Silhouette drawn to scale from the board's dimensions; not a photo. Edit this file in draw.io." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#60646E;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="520" y="470" width="650" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>